# Copier en .env (jamais commité) et remplir. En production, les secrets sont des secrets Fly.io
# et les réglages publics sont dans fly.toml [env] (ARCHITECTURE §11).

# --- Lot A : le mode du site (toutes facultatives, valeurs par défaut ci-dessous) ---
SITE_MODE=auto                             # auto, teaser ou ouvert
SITE_OUVERT_LE=2026-11-13T17:00:00+01:00   # toujours avec le fuseau
TEASER_LIEN_ENTRER=                        # vide : bouton « Entrer dans la tour » masqué ; renseigné le jour J
SITE_URL=                                  # ex. https://<domaine>
FUSEAU=Europe/Paris
SITE_PORT=8080
JOURNAL_NIVEAU=INFO

# --- Facultative au lot A : sans elle, /sante répond « base absente » ---
DATABASE_URL=                  # postgresql+asyncpg://… (pooler Supabase en mode session, port 5432) : SECRET

# --- Tests locaux uniquement (Postgres jetable sous Docker, voir README) ---
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:54329/epreuve_test
