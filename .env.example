# Copier en .env (jamais commité) et remplir. En production, ces valeurs sont des secrets Fly.io.

# --- Obligatoires dès le jalon bêta ---
DISCORD_TOKEN=                 # jeton du bot (portail développeur Discord) : SECRET
DISCORD_GUILD_ID=              # identifiant du serveur « L'Épreuve des Dieux »
DISCORD_ADMIN_ROLE_ID=         # identifiant du rôle « Administrateur »
DISCORD_SCREEN_CHANNEL_ID=     # identifiant de #screen-validation
DATABASE_URL=                  # postgresql+asyncpg://… (pooler Supabase en mode session, port 5432) : SECRET
SITE_PORT=8080
FUSEAU=Europe/Paris
JOURNAL_NIVEAU=INFO

# --- Jalon lancement (facultatives en bêta) ---
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_ANNONCE_CHANNEL_ID=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # SECRET
ANTHROPIC_API_KEY=             # SECRET
IA_ACTIVE=false
IA_MODELE=claude-haiku-5-5

# --- Tests locaux uniquement (Postgres jetable sous Docker, voir README) ---
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:54329/epreuve_test
